PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/tarot_reading

# JWT Secret
JWT_SECRET=super_secret_tarot_mystic_jwt_key_987654321
JWT_EXPIRES_IN=7d

# SMTP Configuration (Gmail or any SMTP server)
# If left blank, emails will be logged to console in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mystic Tarot" <noreply@mystictarot.com>

# Frontend client URL (for CORS and reset links)
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_NAME="Head Tarot Reader"
ADMIN_EMAIL=admin@mystictarot.com
ADMIN_PASSWORD=AdminSecurePass123!
