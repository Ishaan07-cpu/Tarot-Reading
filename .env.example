# =============================================================
# Tarot Reading Platform - Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# =============================================================

# Server
PORT=5000
NODE_ENV=development

# =============================================================
# DATABASE
# =============================================================
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/tarot_reading
# Production (MongoDB Atlas) - set this in Render environment:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tarot_reading?retryWrites=true&w=majority

# =============================================================
# JWT
# =============================================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# =============================================================
# SMTP / EMAIL
# =============================================================
# Gmail: Use an App Password (not your real Gmail password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM="Mystic Tarot" <your_gmail_address@gmail.com>

# =============================================================
# FRONTEND / CORS
# =============================================================
# Local development:
CLIENT_URL=http://localhost:5173
# Production (set in Render to your Vercel URL):
# CLIENT_URL=https://your-app.vercel.app

# =============================================================
# ADMIN SEED CREDENTIALS
# =============================================================
# Used ONLY once when running: npm run seed:admin
# Change these before seeding in production.
ADMIN_NAME="Head Tarot Reader"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
